# Firebase Web App configuration (public client values, not credentials).
# Copy to .env.local and replace the values with your sandbox project's Web app config.
VITE_FIREBASE_API_KEY=replace-with-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-with-project-id
VITE_FIREBASE_APP_ID=replace-with-web-app-id
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Leave false for a real Firebase sandbox project. Emulator tests set this automatically.
VITE_FIREBASE_USE_EMULATORS=false

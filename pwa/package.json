{
  "name": "zymptom-pwa-m0",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview",
    "phone:android": "bash scripts/test-android.sh",
    "test": "vitest run tests/unit",
    "test:firebase": "vitest run tests/firebase/sandbox.test.ts --maxWorkers=1",
    "test:e2e": "playwright test",
    "test:auth-diagnostics": "playwright test --config playwright.auth-diagnostics.config.ts",
    "test:firebase:e2e": "playwright test --config playwright.firebase.config.ts",
    "build:firebase-test": "VITE_FIREBASE_API_KEY=demo-api-key VITE_FIREBASE_AUTH_DOMAIN=localhost VITE_FIREBASE_PROJECT_ID=demo-zymptom-z51 VITE_FIREBASE_APP_ID=1:0:web:demo VITE_FIREBASE_USE_EMULATORS=true npm run build",
    "firebase:emulators": "firebase emulators:start --only auth,firestore --project demo-zymptom-z51",
    "firebase:test": "firebase emulators:exec --only auth,firestore --project demo-zymptom-z51 \"npm run test:firebase && npm run build:firebase-test && npm run test:firebase:e2e\"",
    "firebase:check": "npm run firebase:test && npm run build && npm run check:desktop",
    "firebase:deploy-rules": "firebase deploy --only firestore:rules",
    "check:desktop": "../.venv/bin/python scripts/desktop-fixtures.py --check"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "1.64.1",
    "fake-indexeddb": "6.2.6",
    "firebase-tools": "^15.34.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "firebase": "^11.10.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.6"
    }
  }
}
